{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PlatformIO Debugger",
      "type": "cppdbg",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${command:PlatformIO.buildProject}",
      "preLaunchTask": "PlatformIO: Build (esp32_node1)",
      "setupCommands": [
        {
          "description": "enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
